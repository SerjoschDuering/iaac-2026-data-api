        "inputSchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"summary\": {\n      \"type\": \"string\",\n      \"description\": \"LLM-generated 2-3 sentences. Mention figures/tables/diagrams if present.\"\n    },\n    \"source_type\": {\n      \"type\": \"string\",\n      \"enum\": [\n        \"pdf_page\",\n        \"policy_document\",\n        \"planning_document\",\n        \"design_guideline\",\n        \"technical_standard\",\n        \"research_paper\",\n        \"case_study\",\n        \"species_database\",\n        \"project_report\",\n        \"email\",\n        \"presentation\"\n      ],\n      \"description\": \"Type of source material\"\n    },\n    \"category\": {\n      \"type\": \"string\",\n      \"enum\": [\n        \"climate_microclimate\",\n        \"vegetation_greening\",\n        \"pedestrian_mobility\",\n        \"public_space\",\n        \"transit_infrastructure\",\n        \"building_architecture\",\n        \"water_irrigation\",\n        \"materials_surfaces\",\n        \"policy_regulation\",\n        \"simulation_tools\",\n        \"project_management\",\n        \"general\"\n      ],\n      \"description\": \"Primary topic category\"\n    },\n    \"tags\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"string\"\n      },\n      \"minItems\": 2,\n      \"maxItems\": 15,\n      \"description\": \"5-15 specific keywords: species names, metrics (UTCI, LST), locations, tools, standards\"\n    },\n    \"themes\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"string\"\n      },\n      \"minItems\": 1,\n      \"maxItems\": 8,\n      \"description\": \"Broader themes: thermal_comfort, shade, walkability, native_species, urban_heat_island, etc.\"\n    },\n    \"design_elements\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"string\",\n        \"enum\": [\n          \"trees\",\n          \"shrubs\",\n          \"groundcover\",\n          \"shade_structures\",\n          \"pergolas\",\n          \"paving\",\n          \"water_features\",\n          \"street_furniture\",\n          \"lighting\",\n          \"signage\",\n          \"buildings\",\n          \"pathways\",\n          \"none\"\n        ]\n      },\n      \"description\": \"Physical design elements discussed (if applicable)\"\n    },\n    \"publication_date\": {\n      \"type\": \"string\",\n      \"description\": \"ISO date YYYY-MM-DD, YYYY-MM, or YYYY if known, otherwise null\"\n    }\n  },\n  \"required\": [\n    \"summary\",\n    \"source_type\",\n    \"category\",\n    \"tags\"\n  ]\n}",
